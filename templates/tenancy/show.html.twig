{% extends 'base.html.twig' %}
{% import '_macros.html.twig' as m %}
{% set section = 'vermietung' %}

{% block title %}Mietvertrag {{ tenancy.contractNumber }}{% endblock %}

{% block body %}
<div class="breadcrumb">Vermietung &gt; Mietverhältnisse &gt; {{ tenancy.contractNumber }}</div>
<h2>Mietvertrag {{ tenancy.contractNumber }}</h2>

<table class="table detail">
    <tr><th>Einheit</th><td><a href="{{ path('unit_show', {id: tenancy.unit.id}) }}">{{ tenancy.unit }}</a></td></tr>
    <tr><th>Mieter</th><td>{{ tenancy.tenantNames }}</td></tr>
    <tr><th>Vertragsbeginn</th><td>{{ tenancy.startDate|date('d.m.Y') }}</td></tr>
    <tr><th>Vertragsende</th><td>{{ tenancy.endDate ? tenancy.endDate|date('d.m.Y') : 'unbefristet' }}</td></tr>
    <tr><th>Kündigung vom</th><td>{{ tenancy.noticeDate ? tenancy.noticeDate|date('d.m.Y') }}</td></tr>
    <tr><th>Kaltmiete</th><td>{{ m.money(tenancy.coldRent) }}</td></tr>
    <tr><th>NK-Vorauszahlung</th><td>{{ m.money(tenancy.serviceChargeAdvance) }}</td></tr>
    <tr><th>Gesamtmiete</th><td><b>{{ m.money(tenancy.totalRent) }}</b></td></tr>
    <tr><th>Kaution</th><td>{{ m.money(tenancy.deposit) }}</td></tr>
    <tr><th>Status</th><td>{{ m.tenancy_status(tenancy.status) }}</td></tr>
</table>

<div class="btn-bar">
    {% if tenancy.status == 'DRAFT' %}
        <form method="post" action="{{ path('tenancy_activate', {id: tenancy.id}) }}" class="inline">
            <button class="btn btn-primary">Vertrag unterschrieben - aktivieren</button>
        </form>
    {% endif %}

    {% if tenancy.status == 'ACTIVE' and not tenancy.noticeGiven %}
        <form method="post" action="{{ path('tenancy_terminate', {id: tenancy.id}) }}" class="inline">
            Kündigung vom <input type="date" name="noticeDate" value="{{ 'now'|date('Y-m-d') }}">
            <button class="btn btn-sm btn-default">Kündigung erfassen</button>
        </form>
    {% endif %}

    {% if tenancy.status in ['ACTIVE', 'NOTICE_GIVEN'] and is_granted('ROLE_ADMIN') %}
        <form method="post" action="{{ path('tenancy_terminate_immediately', {id: tenancy.id}) }}" class="inline"
              onsubmit="return confirm('Mietverhältnis wirklich aufheben?')">
            <input type="date" name="endDate" value="{{ 'now'|date('Y-m-d') }}">
            <button class="btn btn-sm btn-danger">Aufhebung / fristlos</button>
        </form>
    {% endif %}

    {% if tenancy.status in ['ACTIVE', 'NOTICE_GIVEN', 'TERMINATED'] %}
        <a href="{{ path('handover_new', {id: tenancy.id}) }}" class="btn btn-sm">Übergabe / Rückgabe</a>
        <a href="{{ path('account_show', {id: tenancy.id}) }}" class="btn btn-sm">Mieterkonto</a>
    {% endif %}
</div>

<div class="cols">
    <div class="col">
        <h3>Mieter</h3>
        <table class="table table-striped table-condensed">
            {% for tenant in tenancy.tenants %}
                <tr>
                    <td><a href="{{ path('tenant_show', {id: tenant.id}) }}">{{ tenant.fullName }}</a></td>
                    <td>
                        <form method="post" action="{{ path('tenancy_tenant', {id: tenancy.id}) }}" class="inline">
                            <input type="hidden" name="tenant" value="{{ tenant.id }}">
                            <input type="hidden" name="action" value="remove">
                            <button class="btn btn-sm">entfernen</button>
                        </form>
                    </td>
                </tr>
            {% endfor %}
        </table>
        <form method="post" action="{{ path('tenancy_tenant', {id: tenancy.id}) }}">
            <select name="tenant">
                {% for t in allTenants %}<option value="{{ t.id }}">{{ t.lastName }}, {{ t.firstName }}</option>{% endfor %}
            </select>
            <button class="btn btn-sm">Mieter hinzufügen</button>
        </form>

        <h3>Übergaben</h3>
        <table class="table table-striped table-condensed">
            <tr><th>Datum</th><th>Art</th><th>Zählerstände</th><th>Schlüssel</th><th>Mängel</th></tr>
            {% for h in tenancy.handovers %}
                <tr>
                    <td>{{ h.date|date('d.m.Y') }}</td>
                    <td>{{ h.type == 'MOVE_IN' ? 'Einzug' : 'Auszug' }}</td>
                    <td>{{ h.meterReadings }}</td>
                    <td>{{ h.keyCount }}</td>
                    <td>{{ h.defects }}</td>
                </tr>
            {% else %}
                <tr><td colspan="5">keine</td></tr>
            {% endfor %}
        </table>
    </div>
    <div class="col">
        <h3>Mieterkonto</h3>
        <table class="table table-striped table-condensed">
            <tr><th>Monat</th><th class="num">Soll</th><th class="num">Zahlung</th><th class="num">offener Saldo</th></tr>
            {% for row in account %}
                <tr>
                    <td>{{ row.month }}</td>
                    <td class="num">{{ m.money(row.debit) }}</td>
                    <td class="num">{{ m.money(row.credit) }}</td>
                    <td class="num">{{ m.money(row.balance) }}</td>
                </tr>
            {% else %}
                <tr><td colspan="4">keine Buchungen</td></tr>
            {% endfor %}
        </table>

        <h3>Termine</h3>
        <table class="table table-striped table-condensed">
            {% for a in appointments %}
                <tr><td>{{ a.startsAt|date('d.m.Y H:i') }}</td><td>{{ a.title }}</td></tr>
            {% else %}
                <tr><td>keine</td></tr>
            {% endfor %}
        </table>
    </div>
</div>

<div class="btn-bar"><a href="{{ path('tenancy_index') }}" class="btn">Zurück</a></div>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Anmeldung{% endblock %}

{% block body %}
<div class="login">
    <h2>Anmeldung</h2>
    {% if error %}
        <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}
    <form method="post">
        <div class="form-group">
            <label for="username">Benutzername</label>
            <input type="text" value="{{ last_username }}" name="_username" id="username" class="form-control" autofocus required>
        </div>
        <div class="form-group">
            <label for="password">Passwort</label>
            <input type="password" name="_password" id="password" class="form-control" required>
        </div>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <button class="btn btn-primary" type="submit">Anmelden</button>
    </form>
</div>
{% endblock %}

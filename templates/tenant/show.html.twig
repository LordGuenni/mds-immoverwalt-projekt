{% extends 'base.html.twig' %}
{% import '_macros.html.twig' as m %}
{% set section = 'stammdaten' %}

{% block title %}{{ tenant.fullName }}{% endblock %}

{% block body %}
<div class="breadcrumb">Stammdaten &gt; Mieter &gt; {{ tenant.fullName }}</div>
<h2>{{ tenant.salutation }} {{ tenant.fullName }} <a href="{{ path('tenant_edit', {id: tenant.id}) }}" class="btn btn-sm">Ändern</a></h2>
<table class="table detail">
    <tr><th>E-Mail</th><td>{{ tenant.email }}</td></tr>
    <tr><th>Telefon</th><td>{{ tenant.phone }}</td></tr>
    <tr><th>Geburtsdatum</th><td>{{ tenant.birthDate ? tenant.birthDate|date('d.m.Y') }}</td></tr>
    <tr><th>Voranschrift</th><td class="pre">{{ tenant.previousAddress }}</td></tr>
    <tr><th>Notizen</th><td class="pre">{{ tenant.notes }}</td></tr>
</table>

<h3>Mietverhältnisse</h3>
<table class="table table-striped">
    <tr><th>Vertrag</th><th>Einheit</th><th>Beginn</th><th>Ende</th><th>Status</th></tr>
    {% for t in tenant.tenancies %}
        <tr>
            <td><a href="{{ path('tenancy_show', {id: t.id}) }}">{{ t.contractNumber }}</a></td>
            <td>{{ t.unit }}</td>
            <td>{{ t.startDate|date('d.m.Y') }}</td>
            <td>{{ t.endDate ? t.endDate|date('d.m.Y') }}</td>
            <td>{{ m.tenancy_status(t.status) }}</td>
        </tr>
    {% else %}
        <tr><td colspan="5">keine</td></tr>
    {% endfor %}
</table>
<div class="btn-bar"><a href="{{ path('tenant_index') }}" class="btn">Zurück</a></div>
{% endblock %}
